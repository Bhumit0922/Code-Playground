<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { pageTitle: isEdit ? 'Edit Question' : 'Add New Question' }) %>
    <link rel="stylesheet" href="/css/admin.css">
    <style>
        .form-section {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-sm);
        }
        .form-section-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .form-section-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }
        .form-group {
            margin-bottom: 1.25rem;
        }
        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.4rem;
            color: var(--text-main);
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-main);
            font-size: 0.95rem;
            font-family: inherit;
            outline: none;
            transition: var(--transition);
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-glow);
            background: rgba(255, 255, 255, 0.05);
        }
        .code-textarea {
            font-family: 'Fira Code', monospace !important;
            font-size: 0.88rem !important;
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <%- include('../partials/navbar', { activePage: 'admin' }) %>

    <main class="admin-container">
        <!-- Header -->
        <div class="admin-header">
            <div class="admin-title-group">
                <h1>
                    <i class="fa-solid <%= isEdit ? 'fa-pen-to-square' : 'fa-circle-plus' %>" style="color: var(--primary);"></i>
                    <%= isEdit ? 'Edit Problem: ' + problem.title : 'Create New Programming Problem' %>
                </h1>
                <p><%= isEdit ? 'Update problem statement, constraints, or test cases.' : 'Author a new problem, configure test suites, and make it available for practice & contests.' %></p>
            </div>
            <div>
                <a href="/admin/problems" class="btn" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); text-decoration: none;">
                    &larr; Back to Problems
                </a>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="admin-nav-tabs">
            <a href="/admin" class="admin-tab"><i class="fa-solid fa-chart-pie"></i> Overview</a>
            <a href="/admin/problems" class="admin-tab"><i class="fa-solid fa-code"></i> Questions Bank</a>
            <a href="/admin/add-problem" class="admin-tab active"><i class="fa-solid fa-square-plus"></i> <%= isEdit ? 'Edit Question' : 'Add Question' %></a>
            <a href="/admin/contests" class="admin-tab"><i class="fa-solid fa-trophy"></i> Contests</a>
            <a href="/admin/users" class="admin-tab"><i class="fa-solid fa-users"></i> Users</a>
        </nav>

        <form id="problem-form">
            <input type="hidden" id="problem-id" value="<%= isEdit && problem ? problem._id : '' %>">

            <!-- Section 1: Basic Information -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fa-solid fa-info-circle" style="color: var(--primary);"></i> 1. Basic Metadata
                </div>
                <div class="form-section-desc">Define the core identification, categorization, and difficulty of the question.</div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="title">Problem Title *</label>
                        <input type="text" id="title" required placeholder="e.g. Longest Consecutive Sequence" value="<%= isEdit && problem ? problem.title : '' %>">
                    </div>

                    <div class="form-group">
                        <label for="difficulty">Difficulty Level *</label>
                        <select id="difficulty" required>
                            <option value="Easy" <%= isEdit && problem && problem.difficulty === 'Easy' ? 'selected' : '' %>>Easy</option>
                            <option value="Medium" <%= !isEdit || (problem && problem.difficulty === 'Medium') ? 'selected' : '' %>>Medium</option>
                            <option value="Hard" <%= isEdit && problem && problem.difficulty === 'Hard' ? 'selected' : '' %>>Hard</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="topic">Topic / Category *</label>
                        <select id="topic" required>
                            <option value="Arrays" <%= !isEdit || (problem && problem.topic === 'Arrays') ? 'selected' : '' %>>Arrays</option>
                            <option value="Strings" <%= isEdit && problem && problem.topic === 'Strings' ? 'selected' : '' %>>Strings</option>
                            <option value="Hash Table" <%= isEdit && problem && problem.topic === 'Hash Table' ? 'selected' : '' %>>Hash Table</option>
                            <option value="Linked Lists" <%= isEdit && problem && problem.topic === 'Linked Lists' ? 'selected' : '' %>>Linked Lists</option>
                            <option value="Trees & Graphs" <%= isEdit && problem && problem.topic === 'Trees & Graphs' ? 'selected' : '' %>>Trees & Graphs</option>
                            <option value="Dynamic Programming" <%= isEdit && problem && problem.topic === 'Dynamic Programming' ? 'selected' : '' %>>Dynamic Programming</option>
                            <option value="Binary Search" <%= isEdit && problem && problem.topic === 'Binary Search' ? 'selected' : '' %>>Binary Search</option>
                            <option value="Greedy" <%= isEdit && problem && problem.topic === 'Greedy' ? 'selected' : '' %>>Greedy</option>
                            <option value="Math & Geometry" <%= isEdit && problem && problem.topic === 'Math & Geometry' ? 'selected' : '' %>>Math & Geometry</option>
                            <option value="Algorithms" <%= isEdit && problem && problem.topic === 'Algorithms' ? 'selected' : '' %>>General Algorithms</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="tags">Tags (Comma-separated)</label>
                        <input type="text" id="tags" placeholder="e.g. Array, Hash Table, Sorting" value="<%= isEdit && problem && problem.tags ? (Array.isArray(problem.tags) ? problem.tags.join(', ') : problem.tags) : '' %>">
                    </div>
                </div>
            </div>

            <!-- Section 2: Statement & Specifications -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fa-solid fa-file-lines" style="color: #22d3ee;"></i> 2. Problem Statement & Specifications
                </div>
                <div class="form-section-desc">Write the problem description, expected input/output specifications, and constraints.</div>

                <div class="form-group">
                    <label for="description">Problem Statement (Supports Markdown) *</label>
                    <textarea id="description" rows="7" required placeholder="Describe the task clearly. Include problem background, formal definitions, and examples..."><%= isEdit && problem ? problem.description : '' %></textarea>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="inputFormat">Input Format</label>
                        <textarea id="inputFormat" rows="3" placeholder="e.g. First line contains an integer N. Next line contains N space-separated integers."><%= isEdit && problem ? (problem.inputFormat || '') : '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="outputFormat">Output Format</label>
                        <textarea id="outputFormat" rows="3" placeholder="e.g. Print a single integer representing the length of the longest consecutive elements sequence."><%= isEdit && problem ? (problem.outputFormat || '') : '' %></textarea>
                    </div>
                </div>

                <div class="form-group">
                    <label for="constraints">Constraints</label>
                    <textarea id="constraints" rows="3" placeholder="e.g. 1 <= nums.length <= 10^5&#10;-10^9 <= nums[i] <= 10^9&#10;Time Limit: 2.0s&#10;Memory Limit: 256MB"><%= isEdit && problem ? (typeof problem.constraints === 'object' ? JSON.stringify(problem.constraints) : problem.constraints) : '' %></textarea>
                </div>
            </div>

            <!-- Section 3: Sample Demonstration -->
            <div class="form-section">
                <div class="form-section-title">
                    <i class="fa-solid fa-lightbulb" style="color: #fbbf24;"></i> 3. Sample Case
                </div>
                <div class="form-section-desc">The sample case displayed prominently to students on the problem page.</div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label for="sampleInput">Sample Input *</label>
                        <textarea id="sampleInput" rows="4" class="code-textarea" required placeholder="6&#10;100 4 200 1 3 2"><%= isEdit && problem ? (problem.sampleInput || '') : '' %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="sampleOutput">Sample Output *</label>
                        <textarea id="sampleOutput" rows="4" class="code-textarea" required placeholder="4"><%= isEdit && problem ? (problem.sampleOutput || '') : '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- Section 4: Test Case Suite -->
            <div class="form-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                    <div class="form-section-title" style="margin-bottom: 0;">
                        <i class="fa-solid fa-flask" style="color: #34d399;"></i> 4. Test Case Suite
                    </div>
                    <button type="button" id="add-testcase-btn" class="btn-action btn-action-success" style="padding: 0.5rem 1rem;">
                        <i class="fa-solid fa-plus"></i> Add Test Case
                    </button>
                </div>
                <div class="form-section-desc">Add test cases against which participant solutions will be automatically evaluated.</div>

                <div id="test-cases-container">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <!-- Form Actions -->
            <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                <a href="/admin/problems" class="btn" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); text-decoration: none; padding: 0.75rem 1.5rem; border-radius: var(--radius-sm);">
                    Cancel
                </a>
                <button type="submit" id="submit-btn" class="btn btn-primary" style="padding: 0.75rem 2.5rem; font-weight: 700; font-size: 1rem;">
                    <i class="fa-solid fa-check"></i> <%= isEdit ? 'Update Problem' : 'Publish Problem' %>
                </button>
            </div>
        </form>
    </main>

    <%- include('../partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const role = localStorage.getItem('role');
            if (role !== 'admin') {
                alert('Access Restricted: You must be logged in as an Administrator.');
                window.location.href = '/signin';
                return;
            }

            // Existing test cases or initial default
            let testCases = [];
            <% if (isEdit && problem && problem.testCases && problem.testCases.length > 0) { %>
                testCases = <%- JSON.stringify(problem.testCases) %>;
            <% } else { %>
                testCases = [
                    { input: "4\n2 7 11 15\n9", output: "0 1", isHidden: false },
                    { input: "3\n3 2 4\n6", output: "1 2", isHidden: true }
                ];
            <% } %>

            const container = document.getElementById('test-cases-container');
            const addBtn = document.getElementById('add-testcase-btn');

            function renderTestCases() {
                container.innerHTML = '';
                testCases.forEach((tc, idx) => {
                    const card = document.createElement('div');
                    card.className = 'test-case-card';
                    card.innerHTML = `
                        <div class="test-case-header">
                            <span class="test-case-num"><i class="fa-solid fa-vial"></i> Test Case #${idx + 1}</span>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; cursor: pointer; color: var(--text-muted);">
                                    <input type="checkbox" class="tc-hidden" ${tc.isHidden ? 'checked' : ''} onchange="updateTestCaseHidden(${idx}, this.checked)">
                                    Hidden Test
                                </label>
                                ${testCases.length > 1 ? `
                                    <button type="button" onclick="removeTestCase(${idx})" class="btn-action btn-action-danger" style="padding: 2px 8px;">
                                        <i class="fa-solid fa-trash"></i> Remove
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                        <div class="form-grid-2">
                            <div>
                                <label style="font-size: 0.82rem; color: var(--text-muted); display: block; margin-bottom: 0.3rem;">Input</label>
                                <textarea rows="3" class="code-textarea tc-input" onchange="updateTestCaseInput(${idx}, this.value)" style="width: 100%; border: 1px solid var(--border-color); border-radius: 4px; padding: 0.5rem; background: rgba(0,0,0,0.2); color: var(--text-main); font-size: 0.85rem;" placeholder="Test case input stdin...">${tc.input || ''}</textarea>
                            </div>
                            <div>
                                <label style="font-size: 0.82rem; color: var(--text-muted); display: block; margin-bottom: 0.3rem;">Expected Output</label>
                                <textarea rows="3" class="code-textarea tc-output" onchange="updateTestCaseOutput(${idx}, this.value)" style="width: 100%; border: 1px solid var(--border-color); border-radius: 4px; padding: 0.5rem; background: rgba(0,0,0,0.2); color: var(--text-main); font-size: 0.85rem;" placeholder="Expected stdout...">${tc.output || ''}</textarea>
                            </div>
                        </div>
                    `;
                    container.appendChild(card);
                });
            }

            window.updateTestCaseInput = (idx, val) => { testCases[idx].input = val; };
            window.updateTestCaseOutput = (idx, val) => { testCases[idx].output = val; };
            window.updateTestCaseHidden = (idx, val) => { testCases[idx].isHidden = val; };
            window.removeTestCase = (idx) => {
                testCases.splice(idx, 1);
                renderTestCases();
            };

            addBtn.addEventListener('click', () => {
                testCases.push({ input: '', output: '', isHidden: false });
                renderTestCases();
            });

            renderTestCases();

            // Handle Submit
            const form = document.getElementById('problem-form');
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const isEdit = <%= isEdit ? 'true' : 'false' %>;
                const problemId = document.getElementById('problem-id').value;

                // Sync test cases from DOM
                const inputElems = container.querySelectorAll('.tc-input');
                const outputElems = container.querySelectorAll('.tc-output');
                const hiddenElems = container.querySelectorAll('.tc-hidden');

                const finalTestCases = [];
                for (let i = 0; i < inputElems.length; i++) {
                    finalTestCases.push({
                        input: inputElems[i].value,
                        output: outputElems[i].value,
                        isHidden: hiddenElems[i].checked
                    });
                }

                if (finalTestCases.length === 0) {
                    alert('Please provide at least one test case.');
                    return;
                }

                const payload = {
                    title: document.getElementById('title').value.trim(),
                    difficulty: document.getElementById('difficulty').value,
                    topic: document.getElementById('topic').value,
                    tags: document.getElementById('tags').value.split(',').map(t => t.trim()).filter(Boolean),
                    description: document.getElementById('description').value.trim(),
                    inputFormat: document.getElementById('inputFormat').value.trim(),
                    outputFormat: document.getElementById('outputFormat').value.trim(),
                    constraints: document.getElementById('constraints').value.trim(),
                    sampleInput: document.getElementById('sampleInput').value.trim(),
                    sampleOutput: document.getElementById('sampleOutput').value.trim(),
                    testCases: finalTestCases
                };

                const submitBtn = document.getElementById('submit-btn');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

                try {
                    const url = isEdit ? `/api/problems/${problemId}` : '/api/problems/add';
                    const method = isEdit ? 'PUT' : 'POST';

                    const res = await fetch(url, {
                        method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();
                    if (res.ok) {
                        alert(isEdit ? 'Problem updated successfully!' : 'Problem created and published successfully!');
                        window.location.href = '/admin/problems';
                    } else {
                        alert(data.message || 'Failed to save problem.');
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = isEdit ? 'Update Problem' : 'Publish Problem';
                    }
                } catch (err) {
                    console.error(err);
                    alert('Server error while saving problem.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = isEdit ? 'Update Problem' : 'Publish Problem';
                }
            });
        });
    </script>
</body>
</html>
