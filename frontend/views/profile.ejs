<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'User Profile' }) %>
    <link rel="stylesheet" href="/css/profile.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .profile-wrapper {
            max-width: 1100px;
            margin: 2.5rem auto 4rem;
            padding: 0 1.5rem;
        }
        .profile-card {
            background: #ffffff;
            border-radius: var(--radius);
            border: 1px solid var(--border-color);
            padding: 2rem;
            box-shadow: var(--shadow-sm);
            margin-bottom: 2rem;
        }
        .profile-header-flex {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1.5rem;
        }
        .profile-avatar-container {
            position: relative;
            width: 90px;
            height: 90px;
        }
        .profile-avatar-img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--primary-light);
            background: var(--light-bg);
        }
        .avatar-upload-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border: 2px solid white;
            font-size: 0.8rem;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.25rem;
            margin-top: 1.5rem;
        }
        .stat-card {
            background: var(--light-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 1.25rem;
            text-align: center;
        }
        .stat-card h3 {
            font-size: 1.8rem;
            color: var(--primary);
            font-weight: 700;
        }
        .stat-card p {
            color: var(--text-muted);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 0.25rem;
        }
        .history-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            margin-top: 1rem;
        }
        .history-table th {
            background: #f8fafc;
            padding: 0.85rem 1rem;
            font-size: 0.82rem;
            color: var(--text-muted);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border-color);
        }
        .history-table td {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.92rem;
        }
        .not-logged-in-box {
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 3.5rem 2rem;
            text-align: center;
            max-width: 500px;
            margin: 3rem auto;
            box-shadow: var(--shadow-sm);
        }
    </style>
</head>

<body>
    <!-- Navbar -->
    <%- include('partials/navbar', { activePage: 'profile' }) %>

    <main class="profile-wrapper">
        <!-- Not signed in placeholder -->
        <div id="not-logged-in-view" class="not-logged-in-box" style="display:none;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">👤</div>
            <h2 style="font-size: 1.5rem; color: var(--dark); margin-bottom: 0.5rem;">You are not signed in</h2>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">Sign in or create an account to track your solved problems, contest ratings, and submissions history.</p>
            <div style="display: flex; gap: 0.75rem; justify-content: center;">
                <a href="/signin" class="btn" style="background: var(--light-bg); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.7rem 1.5rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 500;">Sign In</a>
                <!-- Fixed Sign Up link (previously redirected to /signin) -->
                <a href="/signup" class="btn" style="background: var(--primary); color: white; padding: 0.7rem 1.5rem; border-radius: var(--radius-sm); text-decoration: none; font-weight: 600;">Sign Up</a>
            </div>
        </div>

        <!-- Logged in view -->
        <div id="logged-in-view" style="display:none;">
            <!-- Profile Info Card -->
            <div class="profile-card">
                <div class="profile-header-flex">
                    <div style="display: flex; align-items: center; gap: 1.5rem;">
                        <div class="profile-avatar-container">
                            <img id="user-avatar-img" src="/profile.png" alt="Profile Avatar" class="profile-avatar-img">
                            <label for="avatar-input" class="avatar-upload-btn" title="Change Avatar">
                                <i class="fas fa-camera"></i>
                            </label>
                            <input type="file" id="avatar-input" accept="image/*" style="display:none;">
                        </div>
                        <div>
                            <h1 id="profile-username" style="font-size: 1.6rem; color: var(--dark);">User Profile</h1>
                            <p id="profile-email" style="color: var(--text-muted); font-size: 0.95rem;">user@example.com</p>
                            <span id="profile-role-badge" class="badge" style="background: #e0e7ff; color: #4338ca; margin-top: 0.4rem;">Coder</span>
                        </div>
                    </div>

                    <div>
                        <button id="profile-logout-btn" class="btn" style="background: #fee2e2; color: #ef4444; border: 1px solid #fca5a5; padding: 0.6rem 1.25rem; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer;">
                            <i class="fas fa-sign-out-alt"></i> Sign Out
                        </button>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3 id="stat-solved">0</h3>
                        <p>Problems Solved</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="stat-rating">1500</h3>
                        <p>Contest Rating</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="stat-submissions">0</h3>
                        <p>Total Submissions</p>
                    </div>
                    <div class="stat-card">
                        <h3 id="stat-acceptance">0%</h3>
                        <p>Acceptance Rate</p>
                    </div>
                </div>
            </div>

            <!-- Recent Submissions Card -->
            <div class="profile-card">
                <h2 style="font-size: 1.25rem; color: var(--dark); margin-bottom: 0.75rem;">Recent Submissions</h2>
                <div class="table-responsive">
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Problem</th>
                                <th>Status</th>
                                <th>Language</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody id="recent-submissions-body">
                            <tr><td colspan="4" style="text-align:center; padding: 2rem; color: var(--text-muted);">Loading submissions...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const userId = localStorage.getItem('userId');

            if (!userId) {
                document.getElementById('not-logged-in-view').style.display = 'block';
                return;
            }

            document.getElementById('logged-in-view').style.display = 'block';

            try {
                const res = await fetch(`/api/auth/profile/${userId}`);
                if (!res.ok) throw new Error('Profile fetch failed');

                const data = await res.json();
                const user = data.user;
                const stats = data.stats;

                document.getElementById('profile-username').textContent = user.username;
                document.getElementById('profile-email').textContent = user.email;
                document.getElementById('profile-role-badge').textContent = (user.role || 'user').toUpperCase();

                if (user.profilePicture) {
                    document.getElementById('user-avatar-img').src = user.profilePicture;
                }

                document.getElementById('stat-solved').textContent = stats.problemsSolved || 0;
                document.getElementById('stat-rating').textContent = (user.contestRating && user.contestRating.current) ? user.contestRating.current : 1500;
                document.getElementById('stat-submissions').textContent = stats.totalSubmissions || 0;
                document.getElementById('stat-acceptance').textContent = `${stats.acceptanceRate || 0}%`;

                // Render submissions
                const subBody = document.getElementById('recent-submissions-body');
                const subs = data.submissions || [];

                if (subs.length === 0) {
                    subBody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 2rem; color: var(--text-muted);">No submissions yet. Start solving problems!</td></tr>';
                } else {
                    subBody.innerHTML = subs.map(s => {
                        const isAccepted = s.status === 'Accepted';
                        const time = new Date(s.timestamp).toLocaleDateString([], { dateStyle: 'short', timeStyle: 'short' });
                        const problemTitle = (s.problem && s.problem.title) ? s.problem.title : 'Algorithmic Problem';
                        const problemId = s.problem && s.problem._id ? s.problem._id : s.problem;

                        return `
                            <tr>
                                <td>
                                    <a href="/editcode/${problemId}" style="font-weight: 600; color: var(--primary); text-decoration: none;">
                                        ${problemTitle}
                                    </a>
                                </td>
                                <td><span class="badge ${isAccepted ? 'badge-easy' : 'badge-hard'}">${s.status}</span></td>
                                <td>${s.language || 'python'}</td>
                                <td style="color: var(--text-muted); font-size: 0.85rem;">${time}</td>
                            </tr>
                        `;
                    }).join('');
                }

            } catch (err) {
                console.error(err);
            }

            // Avatar Upload
            document.getElementById('avatar-input').addEventListener('change', async (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const formData = new FormData();
                formData.append('profilePicture', file);
                formData.append('userId', userId);

                try {
                    const res = await fetch('/api/auth/upload-profile-picture', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (res.ok && data.profilePicture) {
                        document.getElementById('user-avatar-img').src = data.profilePicture;
                        localStorage.setItem('profilePicture', data.profilePicture);
                        window.showToast('Profile photo updated successfully!', 'success');
                    } else {
                        window.showToast(data.message || 'Error uploading photo', 'error');
                    }
                } catch (err) {
                    window.showToast('Error uploading profile image', 'error');
                }
            });

            // Logout
            document.getElementById('profile-logout-btn').addEventListener('click', () => {
                localStorage.removeItem('userId');
                localStorage.removeItem('username');
                localStorage.removeItem('userEmail');
                localStorage.removeItem('role');
                localStorage.removeItem('token');
                localStorage.removeItem('profilePicture');
                window.location.href = '/signin';
            });
        });
    </script>
</body>
</html>