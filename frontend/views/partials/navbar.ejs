<!-- Global Auth Required Modal -->
<div class="cp-auth-overlay" id="cp-auth-overlay">
  <div class="cp-auth-modal">
    <div class="cp-auth-modal-icon">
      <i class="fas fa-lock"></i>
    </div>
    <h3 id="cp-auth-modal-title">Sign In Required</h3>
    <p id="cp-auth-modal-desc">You need to sign in to access this feature and track your progress.</p>
    <div class="cp-auth-modal-actions">
      <a href="/signin" id="cp-auth-modal-login-btn" class="cp-auth-btn-login">
        <i class="fas fa-sign-in-alt"></i> Sign In to Continue
      </a>
      <a href="/signup" class="cp-auth-btn-signup">
        <i class="fas fa-user-plus"></i> Create Free Account
      </a>
      <button type="button" class="cp-auth-btn-cancel" id="cp-auth-modal-cancel">
        Dismiss
      </button>
    </div>
  </div>
</div>

<!-- Global Toast Container -->
<div class="cp-toast-container" id="cp-toast-container"></div>

<script>
(function() {
  // Global Notification & Auth helpers
  window.showToast = function(message, type = 'info') {
    const container = document.getElementById('cp-toast-container');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `cp-toast toast-${type}`;
    const iconMap = {
      success: 'fa-check-circle',
      error: 'fa-triangle-exclamation',
      warning: 'fa-circle-exclamation',
      info: 'fa-circle-info'
    };
    const icon = iconMap[type] || 'fa-bell';
    toast.innerHTML = `<i class="fas ${icon}"></i> <span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(50px)';
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  };

  window.showAuthModal = function(actionDesc) {
    const overlay = document.getElementById('cp-auth-overlay');
    const desc = document.getElementById('cp-auth-modal-desc');
    const loginBtn = document.getElementById('cp-auth-modal-login-btn');
    if (desc && actionDesc) desc.textContent = actionDesc;
    if (loginBtn) {
      const currentUrl = encodeURIComponent(window.location.pathname + window.location.search);
      loginBtn.href = `/signin?redirect=${currentUrl}`;
    }
    if (overlay) overlay.classList.add('show');
  };

  window.hideAuthModal = function() {
    const overlay = document.getElementById('cp-auth-overlay');
    if (overlay) overlay.classList.remove('show');
  };

  window.requireAuth = function(actionDesc = 'Please sign in to continue.') {
    const userId = localStorage.getItem('userId');
    if (!userId) {
      window.showAuthModal(actionDesc);
      return false;
    }
    return true;
  };

  const cancelBtn = document.getElementById('cp-auth-modal-cancel');
  if (cancelBtn) cancelBtn.addEventListener('click', window.hideAuthModal);
  const overlayElem = document.getElementById('cp-auth-overlay');
  if (overlayElem) {
    overlayElem.addEventListener('click', (e) => {
      if (e.target === overlayElem) window.hideAuthModal();
    });
  }
  // Mobile drawer controls
  const toggleBtn = document.getElementById('cp-mobile-toggle-btn');
  const closeBtn = document.getElementById('cp-drawer-close-btn');
  const drawer = document.getElementById('cp-mobile-drawer');
  const overlay = document.getElementById('cp-drawer-overlay');

  function openDrawer() {
    if (drawer && overlay) {
      drawer.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (drawer && overlay) {
      drawer.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }
  }

  if (toggleBtn) toggleBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

  // Authentication State Sync
  function syncAuthState() {
    const userId = localStorage.getItem('userId');
    const role = localStorage.getItem('role');
    const username = localStorage.getItem('username') || localStorage.getItem('userEmail') || 'User';
    const desktopAuth = document.getElementById('cp-desktop-auth');
    const mobileAuth = document.getElementById('cp-mobile-auth');
    const adminNavItem = document.getElementById('cp-admin-nav-item');
    const adminDrawerItem = document.getElementById('cp-admin-drawer-item');

    if (role === 'admin') {
      if (adminNavItem) adminNavItem.style.display = 'block';
      if (adminDrawerItem) adminDrawerItem.style.display = 'block';
    }

    if (userId) {
      // Logged in UI
      const userPic = localStorage.getItem('profilePicture') || '/profile.png';
      const adminDropdownLink = role === 'admin' ? `<a href="/admin" style="color:#818cf8; font-weight:600;"><i class="fas fa-shield-halved"></i> Admin Console</a>` : '';
      
      if (desktopAuth) {
        desktopAuth.innerHTML = `
          <div class="cp-user-pill" id="cp-user-menu-btn" tabindex="0">
            <img src="${userPic}" alt="${username}" class="cp-user-avatar" onerror="this.src='/profile.png'">
            <span class="cp-user-name">${username.split('@')[0]}</span>
            <i class="fas fa-chevron-down" style="font-size:0.75rem; color:#94a3b8;"></i>
            
            <div class="cp-user-dropdown" id="cp-user-dropdown">
              ${adminDropdownLink}
              <a href="/profile"><i class="fas fa-user-circle"></i> My Profile</a>
              <a href="/create_contest"><i class="fas fa-plus-circle"></i> Create Contest</a>
              <button type="button" class="logout-item" id="cp-logout-btn"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
            </div>
          </div>
        `;
      }

      if (mobileAuth) {
        const mobileAdminLink = role === 'admin' ? `<a href="/admin" class="cp-drawer-link" style="color:#818cf8;"><i class="fas fa-shield-halved"></i> Admin Console</a>` : '';
        mobileAuth.innerHTML = `
          ${mobileAdminLink}
          <a href="/profile" class="cp-drawer-link"><i class="fas fa-user-circle"></i> Profile (${username.split('@')[0]})</a>
          <a href="/create_contest" class="cp-drawer-link"><i class="fas fa-plus-circle"></i> Create Contest</a>
          <button type="button" class="cp-drawer-link" id="cp-mobile-logout-btn" style="background:transparent; border:none; color:#f87171; cursor:pointer; width:100%;"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
        `;
      }

      // Attach dropdown & logout events
      setTimeout(() => {
        const pill = document.getElementById('cp-user-menu-btn');
        const dropdown = document.getElementById('cp-user-dropdown');
        if (pill && dropdown) {
          pill.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('show');
          });
          document.addEventListener('click', () => {
            dropdown.classList.remove('show');
          });
        }

        const handleLogout = () => {
          localStorage.removeItem('userId');
          localStorage.removeItem('username');
          localStorage.removeItem('userEmail');
          localStorage.removeItem('token');
          localStorage.removeItem('profilePicture');
          window.location.href = '/signin';
        };

        const logoutBtn = document.getElementById('cp-logout-btn');
        const mobileLogoutBtn = document.getElementById('cp-mobile-logout-btn');
        if (logoutBtn) logoutBtn.addEventListener('click', handleLogout);
        if (mobileLogoutBtn) mobileLogoutBtn.addEventListener('click', handleLogout);
      }, 50);

    } else {
      // Guest state
      if (desktopAuth) {
        desktopAuth.innerHTML = `
          <a href="/signin" class="cp-btn-nav-login">Sign In</a>
          <a href="/signup" class="cp-btn-nav-signup">Get Started</a>
        `;
      }
      if (mobileAuth) {
        mobileAuth.innerHTML = `
          <a href="/signin" class="cp-btn-nav-login" style="text-align:center;">Sign In</a>
          <a href="/signup" class="cp-btn-nav-signup" style="text-align:center;">Get Started</a>
        `;
      }
    }
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncAuthState);
  } else {
    syncAuthState();
  }
})();
</script>
