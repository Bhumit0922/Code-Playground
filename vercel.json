{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/frontend/imgg/uploads/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|ico|svg))",
      "dest": "/frontend/imgg/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/index.js"
    }
  ]
}