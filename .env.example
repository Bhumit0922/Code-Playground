# ===============================================
# Code Playground - Environment Configuration
# ===============================================

# Port to run the server on (default: 4000)
PORT=4000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local instance)
# Example local: mongodb://127.0.0.1:27017/codeplayground
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/codeplayground?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeplayground

# JWT Secret Key for user authentication tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Code Execution Sandbox Engine Mode:
# 'cloud' (Default, recommended for Vercel, Render, Railway, AWS - uses sandboxed Piston API)
# 'local' (Uses host GCC, JAVAC, Python compilers for Docker/VPS)
EXECUTION_MODE=cloud

# Optional custom Piston API endpoint (if self-hosting Piston)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
