# ===============================================
# Code Playground - Environment Configuration
# ===============================================

# 1. Server Port (Default: 4000)
# Auto-assigned by cloud hosts (Render, Railway, Heroku)
PORT=4000

# 2. Environment Mode ('development' | 'production')
NODE_ENV=development

# 3. MongoDB Connection String
# Local Instance: mongodb://127.0.0.1:27017/codeplayground
# Cloud (MongoDB Atlas Free Tier):
# mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/codeplayground?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codeplayground

# 4. JWT Secret Key (For User Authentication & Sessions)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=codeplayground_super_secret_jwt_key_2026_change_in_production

# 5. Code Execution Engine Mode
# 'auto'  -> Native local compilers if available (Docker/VPS), with cloud sandbox fallback (Recommended)
# 'local' -> Strict local compilation (Python 3, GCC, G++, OpenJDK)
# 'cloud' -> Cloud sandboxing (Wandbox / Piston API)
EXECUTION_MODE=auto

# 6. Optional: Custom Piston API URL & API Key (if self-hosting Piston or using token)
PISTON_API_URL=https://emkc.org/api/v2/piston/execute
PISTON_API_KEY=
